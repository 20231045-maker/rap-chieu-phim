# ==========================================
# CINESTAR CINEMA - ENVIRONMENT CONFIGURATION
# ==========================================

# Port chạy ứng dụng
PORT=3000

# Môi trường chạy (development | production)
NODE_ENV=development

# Khóa bí mật mã hóa phiên làm việc (Session Secret)
# Gợi ý: Trên production nên dùng chuỗi ngẫu nhiên dài từ 32 ký tự trở lên
SESSION_SECRET=cinestar_production_secret_key_cnpm_nhom10_2026

# Cấu hình kết nối MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cinema_db
