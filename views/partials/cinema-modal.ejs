<script>
    // Logic Quản lý Chọn Địa chỉ Cụm Rạp (10 cơ sở: 5 HN, 5 HCM)
    function getCinemaModal() {
        const el = document.getElementById('cinemaSelectModal');
        if (el && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            return bootstrap.Modal.getOrCreateInstance(el);
        }
        return null;
    }

    window.openCinemaModal = function() {
        const modal = getCinemaModal();
        if (modal) {
            modal.show();
        }
    };

    function updateCinemaUI(id, name, city) {
        // Cập nhật Topbar
        const topbarEl = document.getElementById('topbarCinemaName');
        if (topbarEl) {
            topbarEl.textContent = name + ' (' + city + ')';
        }

        // Cập nhật Navbar (Desktop & Mobile)
        const navEl = document.getElementById('navCinemaName');
        if (navEl) {
            navEl.textContent = name;
        }
        const navMobEl = document.getElementById('navCinemaNameMobile');
        if (navMobEl) {
            navMobEl.textContent = name.replace('Cinestar ', '');
        }

        // Cập nhật Home Badge
        const homeBadgeEl = document.getElementById('homeCinemaBadge');
        if (homeBadgeEl) {
            homeBadgeEl.textContent = 'Cụm rạp: ' + name + ' (' + city + ')';
        }

        // Highlight thẻ rạp trong modal
        document.querySelectorAll('.cinema-option-card').forEach(card => {
            const cardId = card.getAttribute('data-cinema-id');
            const btn = card.querySelector('.cinema-choose-btn');
            if (String(cardId) === String(id)) {
                card.classList.add('selected-cinema');
                if (btn) btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Đang chọn';
            } else {
                card.classList.remove('selected-cinema');
                if (btn) btn.innerHTML = 'Chọn rạp <i class="fa-solid fa-chevron-right ms-1"></i>';
            }
        });

        // Tự động chuyển tab tương ứng thành phố
        if (city === 'TP.HCM') {
            const hcmTabBtn = document.getElementById('tab-btn-hcm');
            if (hcmTabBtn && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
                bootstrap.Tab.getOrCreateInstance(hcmTabBtn).show();
            }
        } else {
            const hnTabBtn = document.getElementById('tab-btn-hanoi');
            if (hnTabBtn && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
                bootstrap.Tab.getOrCreateInstance(hnTabBtn).show();
            }
        }
    }

    function selectCinema(id, name, city, address) {
        try {
            // Yêu cầu: Không lưu cơ sở khi đóng web -> dùng sessionStorage và session cookie
            sessionStorage.setItem('selectedCinemaId', String(id));
            sessionStorage.setItem('selectedCinemaName', name);
            sessionStorage.setItem('selectedCinemaCity', city);
            sessionStorage.setItem('selectedCinemaAddress', address || '');
            sessionStorage.setItem('cinemaPromptDismissed', 'true');

            // Xóa triệt để khỏi localStorage (để không lưu vĩnh viễn khi đóng web)
            localStorage.removeItem('selectedCinemaId');
            localStorage.removeItem('selectedCinemaName');
            localStorage.removeItem('selectedCinemaCity');
            localStorage.removeItem('selectedCinemaAddress');

            // Ghi session cookie (không có max-age, tự hủy khi đóng trình duyệt)
            document.cookie = "selectedCinemaId=" + id + "; path=/;";
        } catch (e) {
            console.warn(e);
        }

        updateCinemaUI(id, name, city);

        const modalEl = document.getElementById('cinemaSelectModal');
        const modal = getCinemaModal();
        if (modal) {
            modal.hide();
        }

        // Hiển thị toast thông báo
        const toastEl = document.getElementById('cinemaToast');
        const toastMsg = document.getElementById('cinemaToastMsg');
        if (toastEl && toastMsg && typeof bootstrap !== 'undefined' && bootstrap.Toast) {
            toastMsg.textContent = 'Bạn đã chọn cụm rạp: ' + name + ' (' + city + ')';
            const toast = new bootstrap.Toast(toastEl, { delay: 3500 });
            toast.show();
        }

        // Đợi modal đóng hoàn tất rồi mới tải lại trang (chống kẹt backdrop)
        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', function onHidden() {
                modalEl.removeEventListener('hidden.bs.modal', onHidden);
                window.location.reload();
            }, { once: true });
            setTimeout(() => {
                window.location.reload();
            }, 350);
        } else {
            window.location.reload();
        }
    }

    // Yêu cầu: "hiện chọn cơ sở mỗi khi truy cập web, không lưu cơ sở khi đóng web"
    document.addEventListener('DOMContentLoaded', function() {
        // Dọn sạch dữ liệu cũ trong localStorage (nếu có từ các phiên trước)
        try {
            localStorage.removeItem('selectedCinemaId');
            localStorage.removeItem('selectedCinemaName');
            localStorage.removeItem('selectedCinemaCity');
            localStorage.removeItem('selectedCinemaAddress');
        } catch (e) {}

        // Kiểm tra trong phiên hiện tại (sessionStorage)
        const savedId = sessionStorage.getItem('selectedCinemaId');
        const savedName = sessionStorage.getItem('selectedCinemaName');
        const savedCity = sessionStorage.getItem('selectedCinemaCity');
        const dismissed = sessionStorage.getItem('cinemaPromptDismissed');

        // Gắn sự kiện: khi modal bị ẩn (do bấm Đóng, bấm ra ngoài hoặc ấn ESC), đánh dấu đã đóng để không popup lại liên tục
        const modalEl = document.getElementById('cinemaSelectModal');
        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', function() {
                sessionStorage.setItem('cinemaPromptDismissed', 'true');
                // Tự động dọn sạch backdrop tồn đọng nếu không còn modal nào mở
                setTimeout(() => {
                    if (!document.querySelector('.modal.show')) {
                        document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.removeProperty('overflow');
                        document.body.style.removeProperty('padding-right');
                    }
                }, 100);
            });
        }

        // Không tự động popup trên các trang nội bộ/nghiệp vụ: staff, admin, manager, auth
        const path = window.location.pathname;
        const isRestrictedPath = path.startsWith('/staff') || path.startsWith('/admin') || path.startsWith('/manager') || path.startsWith('/auth');

        if (savedId && savedName) {
            // Đã chọn rạp trong phiên duyệt web hiện tại -> cập nhật hiển thị
            updateCinemaUI(savedId, savedName, savedCity || 'Hà Nội');
        } else if (!dismissed && !isRestrictedPath && path === '/') {
            // Chỉ tự động hiện modal trên Trang chủ khi người dùng mới vào phiên web lần đầu
            setTimeout(function() {
                const modal = getCinemaModal();
                if (modal) {
                    modal.show();
                }
            }, 350);
        }
    });

    // Dọn sạch backdrop mồ côi toàn cục khi bất kỳ modal nào đóng lại
    document.addEventListener('hidden.bs.modal', function () {
        setTimeout(function() {
            if (!document.querySelector('.modal.show')) {
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
            }
        }, 100);
    });
</script>
