<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'CINESTAR Cinema - Đặt Vé Xem Phim Trực Tuyến' %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom CSS (Light Theme Inspired by Beta Cinemas & CGV) -->
    <link rel="stylesheet" href="/css/style.css?v=20261013_seatcolor">
</head>
<body>
    <!-- Topbar (Chuẩn phong cách CGV / Beta Cinemas) -->
    <div class="topbar-cinema d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span><i class="fa-solid fa-phone me-1 text-danger"></i> Hotline: <strong class="text-dark">1900 6017</strong></span>
                <span class="text-secondary">|</span>
                <a href="javascript:void(0)" onclick="openCinemaModal()" class="text-decoration-none text-dark d-flex align-items-center gap-1 hover-danger" title="Nhấp để đổi cụm rạp">
                    <i class="fa-solid fa-location-dot text-danger"></i>
                    <span>Cụm rạp:</span>
                    <strong id="topbarCinemaName" class="text-danger"><%= (typeof selectedCinema !== 'undefined' && selectedCinema) ? (selectedCinema.name + ' (' + selectedCinema.city + ')') : 'Chọn cụm rạp' %></strong>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1" style="font-size: 0.72rem;">[Đổi rạp]</span>
                </a>
                <span class="text-secondary">|</span>
                <span><i class="fa-solid fa-clock me-1 text-primary"></i> Mở cửa: 08:00 - 24:00</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="/pricing"><i class="fa-solid fa-ticket-simple me-1 text-warning"></i> Ưu Đãi Thành Viên</a>
                <span class="text-secondary">|</span>
                <a href="/about"><i class="fa-solid fa-graduation-cap me-1 text-info"></i> Đề Tài ĐACN Nhóm 11</a>
            </div>
        </div>
    </div>

    <!-- Main Navbar (Giao diện sáng CGV & Beta) -->
    <nav class="navbar navbar-expand-lg navbar-light navbar-cinema sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <div class="bg-danger text-white rounded-3 px-2 py-1 d-flex align-items-center justify-content-center shadow-sm">
                    <i class="fa-solid fa-film fs-5"></i>
                </div>
                <span>CINE<span class="brand-accent">STAR</span></span>
            </a>

            <!-- Nút chọn cụm rạp nổi bật trên mobile -->
            <div class="d-flex align-items-center gap-2 d-lg-none ms-auto me-2">
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1 d-flex align-items-center gap-1 fw-bold shadow-sm" onclick="openCinemaModal()" style="font-size: 0.72rem;">
                    <i class="fa-solid fa-location-dot text-danger"></i>
                    <span id="navCinemaNameMobile" class="text-truncate" style="max-width: 120px;"><%= (typeof selectedCinema !== 'undefined' && selectedCinema) ? selectedCinema.name.replace('Cinestar ', '') : 'Chọn rạp' %></span>
                </button>
            </div>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>" href="/">
                            <i class="fa-solid fa-house me-1"></i> Trang Chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/movies') ? 'active' : '' %>" href="/movies">
                            <i class="fa-solid fa-clapperboard me-1"></i> Phim Chiếu Rạp
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/pricing' ? 'active' : '' %>" href="/pricing">
                            <i class="fa-solid fa-tags me-1"></i> Bảng Giá Vé
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/about' ? 'active' : '' %>" href="/about">
                            <i class="fa-solid fa-circle-info me-1"></i> Giới Thiệu
                        </a>
                    </li>
                </ul>

                <!-- Nút Chọn Rạp Nhanh Trên Thanh Menu -->
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 me-lg-3 d-flex align-items-center gap-1 fw-bold shadow-sm" onclick="openCinemaModal()" title="Nhấp để chọn cơ sở rạp">
                    <i class="fa-solid fa-map-pin text-danger"></i>
                    <span id="navCinemaName"><%= (typeof selectedCinema !== 'undefined' && selectedCinema) ? selectedCinema.name : 'Chọn cụm rạp' %></span>
                    <i class="fa-solid fa-angle-down ms-1 text-danger small"></i>
                </button>

                <!-- Tác vụ theo vai trò & Đăng nhập -->
                <div class="d-flex align-items-center gap-2">
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        <!-- Phân quyền nhanh cho Staff / Manager / Admin -->
                        <% if (currentUser.role_name === 'staff' || currentUser.role_name === 'admin' || currentUser.role_name === 'manager') { %>
                            <div class="btn-group me-2 shadow-sm">
                                <a href="/staff/pos" class="btn btn-outline-warning btn-sm fw-bold">
                                    <i class="fa-solid fa-cash-register me-1"></i> POS Quầy
                                </a>
                                <a href="/staff/scan" class="btn btn-outline-info btn-sm fw-bold">
                                    <i class="fa-solid fa-qrcode me-1"></i> Soát Vé
                                </a>
                            </div>
                        <% } %>

                        <% if (currentUser.role_name === 'manager' || currentUser.role_name === 'admin') { %>
                            <a href="/manager/dashboard" class="btn btn-outline-primary btn-sm me-2 fw-bold shadow-sm">
                                <i class="fa-solid fa-chart-pie me-1"></i> Quản Lý
                            </a>
                        <% } %>

                        <% if (currentUser.role_name === 'admin') { %>
                            <a href="/admin/users" class="btn btn-outline-danger btn-sm me-2 fw-bold shadow-sm">
                                <i class="fa-solid fa-shield-halved me-1"></i> Quản Trị
                            </a>
                        <% } %>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-light border dropdown-toggle d-flex align-items-center gap-2 py-1 px-3 rounded-pill shadow-sm" type="button" data-bs-toggle="dropdown">
                                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.75rem;">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <span class="fw-bold text-dark"><%= currentUser.full_name %></span>
                                <span class="badge bg-danger rounded-pill" style="font-size: 0.7rem;"><%= currentUser.role_display %></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark"><%= currentUser.full_name %></div>
                                    <div class="small text-muted"><%= currentUser.email %></div>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="/my-tickets">
                                        <i class="fa-solid fa-ticket me-2 text-danger"></i> Vé của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="/profile">
                                        <i class="fa-solid fa-user-gear me-2 text-info"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger fw-semibold" href="/auth/logout">
                                        <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-bold">
                            <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng Nhập
                        </a>
                        <a href="/auth/register" class="btn btn-danger btn-sm px-3 rounded-pill fw-bold shadow-sm">
                            <i class="fa-solid fa-user-plus me-1"></i> Đăng Ký
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Thanh Breadcrumb chuẩn phong cách CGV Cinemas (Tham khảo hình ảnh yêu cầu) -->
    <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length > 0) { %>
        <nav class="cinema-breadcrumb-bar" aria-label="breadcrumb">
            <div class="container d-flex align-items-center">
                <a href="/" class="crumb-home" title="Trang chủ">
                    <i class="fa-solid fa-house"></i>
                </a>
                <% breadcrumbs.forEach(function(crumb, index) { %>
                    <span class="crumb-separator">›</span>
                    <% if (crumb.url && index < breadcrumbs.length - 1) { %>
                        <a href="<%= crumb.url %>" class="crumb-link"><%= crumb.label %></a>
                    <% } else { %>
                        <span class="crumb-current"><u><%= crumb.label %></u></span>
                    <% } %>
                <% }); %>
            </div>
        </nav>
    <% } %>
    <div class="container mt-3">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm rounded-3" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2 fs-5"></i>
                <div><%= error %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm rounded-3" role="alert">
                <i class="fa-solid fa-circle-check me-2 fs-5"></i>
                <div><%= success %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
    </div>

    <!-- Main Content Body -->
    <main class="main-content">
