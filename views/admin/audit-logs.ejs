<%- include('../layouts/admin-header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-1">Nhật Ký Đơn Hàng & Giao Dịch Toàn Hệ Thống</h4>
        <p class="text-secondary small mb-0">Theo dõi toàn bộ lịch sử bán vé online và tại quầy POS phục vụ công tác thanh tra</p>
    </div>
</div>

<div class="card bg-card border-secondary rounded-4 shadow overflow-hidden">
    <div class="table-responsive">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead>
                <tr class="border-bottom border-secondary text-secondary small">
                    <th>MÃ ĐƠN HÀNG</th>
                    <th>KHÁCH HÀNG</th>
                    <th>PHIM CHIẾU</th>
                    <th>PHÒNG</th>
                    <th>SUẤT CHIẾU</th>
                    <th>KÊNH BÁN</th>
                    <th>TỔNG TIỀN</th>
                    <th>TRẠNG THÁI</th>
                    <th>THỜI GIAN</th>
                </tr>
            </thead>
            <tbody>
                <% if (bookings && bookings.length > 0) { %>
                    <% bookings.forEach(b => { %>
                        <tr class="border-bottom border-secondary border-opacity-25 small">
                            <td><code><%= b.booking_code %></code></td>
                            <td>
                                <div class="fw-bold text-white"><%= b.customer_name %></div>
                                <div class="text-secondary" style="font-size: 0.72rem;"><%= b.customer_phone || b.customer_email %></div>
                            </td>
                            <td class="text-white"><%= b.movie_title %></td>
                            <td><%= b.room_name %></td>
                            <td><span class="badge bg-danger"><%= b.start_time %></span></td>
                            <td>
                                <span class="badge <%= b.booking_type === 'pos' ? 'bg-warning text-dark' : 'bg-primary' %>">
                                    <%= b.booking_type.toUpperCase() %> (<%= b.payment_method %>)
                                </span>
                            </td>
                            <td class="text-warning fw-bold"><%= Number(b.total_amount).toLocaleString('vi-VN') %> đ</td>
                            <td>
                                <span class="badge bg-success">Đã thanh toán</span>
                            </td>
                            <td class="text-secondary"><%= b.created_at %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="9" class="text-center text-secondary py-4">Chưa có giao dịch nào</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layouts/admin-footer') %>
