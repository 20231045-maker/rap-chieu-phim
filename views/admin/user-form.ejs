<%- include('../layouts/admin-header') %>

<div class="card bg-card border-secondary p-4 rounded-4 shadow mb-4">
    <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-3 mb-4">
        <div>
            <h4 class="text-white fw-bold mb-1"><%= isEdit ? 'Cập Nhật Quyền & Tài Khoản' : 'Tạo Tài Khoản Mới' %></h4>
            <p class="text-secondary small mb-0"><%= isEdit ? user.full_name : 'Khởi tạo tài khoản nhân viên hoặc quản trị' %></p>
        </div>
        <a href="/admin/users" class="btn btn-outline-light rounded-pill btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Danh Sách Người Dùng
        </a>
    </div>

    <form action="<%= isEdit ? '/admin/users/edit/' + user.id : '/admin/users/create' %>" method="POST">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label text-light small fw-bold">Họ và tên <span class="text-danger">*</span></label>
                <input type="text" name="full_name" class="form-control bg-dark border-secondary text-white" value="<%= isEdit ? user.full_name : '' %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label text-light small fw-bold">Địa chỉ Email <span class="text-danger">*</span></label>
                <input type="email" name="email" class="form-control bg-dark border-secondary text-white" value="<%= isEdit ? user.email : '' %>" <%= isEdit ? 'readonly disabled' : 'required' %>>
            </div>

            <div class="col-md-6">
                <label class="form-label text-light small fw-bold">Số điện thoại</label>
                <input type="tel" name="phone" class="form-control bg-dark border-secondary text-white" value="<%= isEdit ? (user.phone || '') : '' %>">
            </div>

            <div class="col-md-6">
                <label class="form-label text-light small fw-bold">Phân Quyền Vai Trò (Role) <span class="text-danger">*</span></label>
                <select name="role_id" class="form-select bg-dark border-secondary text-white">
                    <% roles.forEach(r => { %>
                        <option value="<%= r.id %>" <%= isEdit && user.role_id === r.id ? 'selected' : '' %>>
                            <%= r.display_name %> (<%= r.name.toUpperCase() %>)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label text-light small fw-bold">Mật khẩu <%= isEdit ? '(Để trống nếu giữ nguyên)' : '*' %></label>
                <input type="password" name="password" class="form-control bg-dark border-secondary text-white" placeholder="••••••••" <%= isEdit ? '' : 'required' %>>
            </div>

            <div class="col-md-6">
                <label class="form-label text-light small fw-bold">Trạng thái tài khoản</label>
                <select name="status" class="form-select bg-dark border-secondary text-white">
                    <option value="active" <%= isEdit && user.status === 'active' ? 'selected' : '' %>>Hoạt động bình thường</option>
                    <option value="locked" <%= isEdit && user.status === 'locked' ? 'selected' : '' %>>Khóa tài khoản</option>
                </select>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top border-secondary text-end">
            <a href="/admin/users" class="btn btn-outline-light rounded-pill px-4 me-2">Hủy Bỏ</a>
            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-floppy-disk me-1"></i> <%= isEdit ? 'Lưu Thay Đổi' : 'Tạo Tài Khoản' %>
            </button>
        </div>
    </form>
</div>

<%- include('../layouts/admin-footer') %>
