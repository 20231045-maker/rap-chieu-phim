<%- include('../layouts/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-white border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-light border-bottom text-center py-4">
                    <div class="bg-danger text-white rounded-3 p-2 d-inline-flex align-items-center justify-content-center mb-2 shadow-sm">
                        <i class="fa-solid fa-film fs-3"></i>
                    </div>
                    <h4 class="text-dark fw-bold mb-0">Đăng Nhập CINESTAR</h4>
                    <p class="text-muted small mb-0">Hệ thống đặt vé & quản lý suất chiếu rạp</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> <%= error %>
                        </div>
                    <% } %>

                    <form action="/auth/login" method="POST">
                        <input type="hidden" name="returnTo" value="<%= typeof returnTo !== 'undefined' ? returnTo : '' %>">

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Địa chỉ Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">
                                    <i class="fa-solid fa-envelope"></i>
                                </span>
                                <input type="email" name="email" id="inputEmail" class="form-control" placeholder="name@cinema.com" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                                <input type="password" name="password" id="inputPassword" class="form-control" placeholder="••••••••" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-2 fw-bold rounded-pill mb-3 shadow-sm">
                            <i class="fa-solid fa-right-to-bracket me-2"></i> Đăng Nhập
                        </button>
                    </form>

                    <!-- Nút Đăng nhập Nhanh cho Giảng viên / Người kiểm thử (Demo 1-Click) -->
                    <div class="border-top pt-3 mt-3">
                        <div class="text-center text-muted small fw-bold mb-2">
                            <i class="fa-solid fa-bolt text-warning me-1"></i> CHỌN NHANH TÀI KHOẢN DEMO:
                        </div>
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-danger btn-sm text-start" onclick="fillDemo('admin@cinema.com', 'admin123')">
                                <i class="fa-solid fa-shield-halved me-1"></i> <strong>Admin:</strong> admin@cinema.com (Quản trị viên)
                            </button>
                            <button class="btn btn-outline-primary btn-sm text-start" onclick="fillDemo('manager@cinema.com', 'manager123')">
                                <i class="fa-solid fa-chart-line me-1"></i> <strong>Manager:</strong> manager@cinema.com (Quản lý rạp)
                            </button>
                            <button class="btn btn-outline-warning btn-sm text-start" onclick="fillDemo('staff@cinema.com', 'staff123')">
                                <i class="fa-solid fa-cash-register me-1"></i> <strong>Staff:</strong> staff@cinema.com (Nhân viên bán & soát vé)
                            </button>
                            <button class="btn btn-outline-success btn-sm text-start" onclick="fillDemo('client@cinema.com', 'client123')">
                                <i class="fa-solid fa-user me-1"></i> <strong>Client:</strong> client@cinema.com (Khách hàng)
                            </button>
                        </div>
                    </div>

                    <div class="text-center mt-4 text-muted small">
                        Chưa có tài khoản? <a href="/auth/register<%= typeof returnTo !== 'undefined' && returnTo ? '?redirect=' + encodeURIComponent(returnTo) : '' %>" class="text-danger fw-bold text-decoration-none">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function fillDemo(email, pass) {
    document.getElementById('inputEmail').value = email;
    document.getElementById('inputPassword').value = pass;
}
</script>

<%- include('../layouts/footer') %>
