<%- include('../layouts/header') %>

<div class="container py-4">
    <!-- Header Thông tin Suất Chiếu (Light Card) -->
    <div class="card bg-white border p-3 rounded-4 mb-4 shadow-sm">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <a href="/movies/<%= showtime.movie_id %>" class="text-danger small text-decoration-none fw-bold">
                    <i class="fa-solid fa-arrow-left me-1"></i> Đổi suất chiếu khác
                </a>
                <h4 class="text-dark fw-bold mb-1 mt-1"><%= showtime.movie_title %></h4>
                <div class="d-flex flex-wrap gap-3 small text-secondary">
                    <% if (showtime.cinema_name) { %>
                        <span class="text-danger fw-bold"><i class="fa-solid fa-location-dot me-1"></i> <%= showtime.cinema_name %></span>
                    <% } %>
                    <span><i class="fa-solid fa-door-open text-danger me-1"></i> <strong><%= showtime.room_name %></strong></span>
                    <span><i class="fa-solid fa-tv text-primary me-1"></i> <%= showtime.screen_type %></span>
                    <span><i class="fa-regular fa-clock text-info me-1"></i> <%= formatDateTime(showtime.start_time) %></span>
                    <span class="badge bg-danger"><%= showtime.age_rating %></span>
                </div>
            </div>
            <div>
                <span class="badge bg-light text-dark border p-2 fs-6 shadow-sm">
                    Giá vé gốc: <strong class="text-danger"><%= Number(showtime.base_price).toLocaleString('vi-VN') %> đ</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- Khu Vực Sơ Đồ Ghế Trực Quan (Phong cách CGV & Beta Cinemas) -->
    <div class="seat-map-container mb-5 text-center">
        <!-- Màn Hình Chiếu Rạp (Screen Curve) -->
        <div class="screen-stage">
            <div class="screen-curve"></div>
            <div class="screen-label"><i class="fa-solid fa-display me-1"></i> MÀN HÌNH / SCREEN</div>
        </div>

        <!-- Chú Thích Loại Ghế & Trạng Thái (Seat Legend) -->
        <div class="seat-legend mb-4">
            <div class="legend-item">
                <div class="legend-box seat-regular"></div>
                <span>Ghế thường (x1.0)</span>
            </div>
            <div class="legend-item">
                <div class="legend-box seat-vip"></div>
                <span>Ghế VIP (x1.25)</span>
            </div>
            <div class="legend-item">
                <div class="legend-box seat-sweetbox"></div>
                <span>Ghế Sweetbox Đôi (x2.0)</span>
            </div>
            <div class="legend-item">
                <div class="legend-box seat-selected"></div>
                <span>Đang chọn</span>
            </div>
            <div class="legend-item">
                <div class="legend-box seat-locked d-flex align-items-center justify-content-center">
                    <i class="fa-solid fa-lock" style="font-size: 0.65rem;"></i>
                </div>
                <span>Đang giữ chỗ</span>
            </div>
            <div class="legend-item">
                <div class="legend-box seat-booked d-flex align-items-center justify-content-center p-0 overflow-hidden" style="width: 20px; height: 20px; border-radius: 4px;">
                    <img src="/images/icon.jpg" alt="Đã đặt" style="width: 100%; height: 100%; object-fit: cover; border-radius: 3px;">
                </div>
                <span>Đã đặt</span>
            </div>
        </div>

        <!-- Gợi ý vuốt ngang trên điện thoại -->
        <div class="d-md-none text-muted small mb-2 bg-light py-1 px-3 rounded-pill d-inline-block border">
            <i class="fa-solid fa-arrows-left-right me-1 text-danger"></i> Vuốt sang ngang để xem đầy đủ các vị trí ghế
        </div>

        <!-- Lưới Ghế Ngồi (Seat Grid) -->
        <div class="seat-grid py-2">
            <div style="min-width: 580px; display: inline-block;">
                <% rows.forEach(rowChar => { %>
                    <div class="seat-row-wrapper mb-2">
                        <span class="row-label"><%= rowChar %></span>
                        <% seatsByRow[rowChar].forEach(seat => { %>
                            <div class="seat-item seat-<%= seat.seat_type %> seat-<%= seat.current_status %>"
                                 data-seat-id="<%= seat.id %>"
                                 data-seat-code="<%= seat.seat_code %>"
                                 data-seat-price="<%= seat.calculated_price %>"
                                 data-seat-type="<%= seat.seat_type %>"
                                 data-status="<%= seat.current_status %>"
                                 title="Ghế <%= seat.seat_code %> - <%= Number(seat.calculated_price).toLocaleString('vi-VN') %> đ (<%= seat.seat_type.toUpperCase() %>)">
                                <% if (seat.current_status === 'booked') { %>
                                    <img src="/images/icon.jpg" alt="Đã đặt" class="seat-booked-img" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px; pointer-events: none;">
                                <% } else if (seat.current_status === 'locked') { %>
                                    <i class="fa-solid fa-lock" style="font-size: 0.75rem;"></i>
                                <% } else { %>
                                    <%= seat.seat_number %>
                                <% } %>
                            </div>
                        <% }) %>
                        <span class="row-label"><%= rowChar %></span>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
    <!-- Khoảng đệm để fixed bottom không đè nội dung trên mobile -->
    <div class="pb-5 mb-4 d-md-none"></div>
</div>

<!-- Thanh Tóm Tắt & Tiếp Tục (Sticky Bottom Bar - Giao diện sáng) -->
<div class="fixed-bottom bg-white border-top py-2 py-md-3 shadow-lg" style="z-index: 1040;">
    <div class="container">
        <div class="row align-items-center g-2 g-md-3">
            <div class="col-12 col-md-7">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="text-secondary small fw-bold">Ghế đã chọn:</span>
                    <div id="selectedSeatsContainer" class="d-flex flex-wrap gap-1">
                        <span class="text-muted small fst-italic">Chưa chọn ghế nào</span>
                    </div>
                </div>
                <div class="small text-muted d-none d-sm-block">
                    <i class="fa-solid fa-clock-rotate-left me-1 text-danger"></i> Tối đa 8 ghế/giao dịch. Hệ thống giữ chỗ tạm thời trong 5 phút để bạn tiến hành thanh toán.
                </div>
            </div>

            <div class="col-12 col-md-5 d-flex align-items-center justify-content-between justify-content-md-end gap-3">
                <div class="text-start text-md-end">
                    <div class="small text-muted" style="font-size: 0.75rem;">Tổng tiền vé:</div>
                    <div class="fs-4 fw-extrabold text-danger" id="totalPriceDisplay">0 đ</div>
                </div>
                <button id="btnProceed" class="btn btn-danger btn-lg px-4 rounded-pill fw-bold shadow-sm" disabled onclick="handleProceed()">
                    <span>Tiếp Tục</span>
                    <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Script Xử Lý Chọn Ghế & Giữ Ghế Tạm Thời -->
<script>
const showtimeId = <%= showtime.id %>;
let selectedSeats = [];

document.querySelectorAll('.seat-item').forEach(el => {
    el.addEventListener('click', () => {
        const status = el.getAttribute('data-status');
        if (status === 'booked' || status === 'locked' || status === 'maintenance') {
            return;
        }

        const seatId = Number(el.getAttribute('data-seat-id'));
        const seatCode = el.getAttribute('data-seat-code');
        const seatPrice = Number(el.getAttribute('data-seat-price'));
        const seatType = el.getAttribute('data-seat-type');

        const existingIndex = selectedSeats.findIndex(s => s.id === seatId);

        if (existingIndex > -1) {
            // Hủy chọn
            selectedSeats.splice(existingIndex, 1);
            el.classList.remove('seat-selected');
        } else {
            // Chọn mới
            if (selectedSeats.length >= 8) {
                alert('Bạn chỉ có thể chọn tối đa 8 ghế trong một lần đặt!');
                return;
            }
            selectedSeats.push({ id: seatId, code: seatCode, price: seatPrice, type: seatType });
            el.classList.add('seat-selected');
        }

        updateSummary();
    });
});

function updateSummary() {
    const container = document.getElementById('selectedSeatsContainer');
    const totalDisplay = document.getElementById('totalPriceDisplay');
    const btnProceed = document.getElementById('btnProceed');

    if (selectedSeats.length === 0) {
        container.innerHTML = '<span class="text-muted small fst-italic">Chưa chọn ghế nào</span>';
        totalDisplay.innerText = '0 đ';
        btnProceed.disabled = true;
    } else {
        container.innerHTML = selectedSeats.map(s => `
            <span class="badge ${s.type === 'sweetbox' ? 'bg-danger-subtle text-danger border border-danger' : (s.type === 'vip' ? 'bg-warning-subtle text-warning-emphasis border border-warning' : 'bg-light text-dark border')} px-2 py-1 fw-bold">
                ${s.code}
            </span>
        `).join('');

        const total = selectedSeats.reduce((sum, s) => sum + s.price, 0);
        totalDisplay.innerText = total.toLocaleString('vi-VN') + ' đ';
        btnProceed.disabled = false;
    }
}

// Gọi API giữ ghế tạm thời 5 phút
async function handleProceed() {
    if (selectedSeats.length === 0) return;

    const btn = document.getElementById('btnProceed');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Đang giữ chỗ...';

    try {
        const response = await fetch('/booking/api/lock-seats', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                showtimeId: showtimeId,
                seatIds: selectedSeats.map(s => s.id)
            })
        });

        const data = await response.json();

        if (response.status === 401 || data.requireLogin) {
            alert(data.message || 'Vui lòng đăng nhập hoặc đăng ký tài khoản để tiếp tục đặt vé!');
            window.location.href = `/auth/login?redirect=${encodeURIComponent(window.location.pathname)}`;
            return;
        }

        if (response.ok && data.success) {
            window.location.href = `/booking/combos/${showtimeId}`;
        } else {
            alert(data.message || 'Ghế bạn chọn vừa bị người khác giữ chỗ! Vui lòng chọn ghế khác.');
            window.location.reload();
        }
    } catch (err) {
        console.error('Lỗi khi khóa giữ ghế:', err);
        alert('Có lỗi kết nối mạng! Vui lòng thử lại.');
        btn.disabled = false;
        btn.innerHTML = 'Tiếp Tục <i class="fa-solid fa-arrow-right ms-2"></i>';
    }
}
</script>

<%- include('../layouts/footer') %>
