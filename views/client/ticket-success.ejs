<%- include('../layouts/header') %>

<div class="container py-4 mb-5">
    <!-- Thông Báo Đặt Vé Thành Công -->
    <div class="text-center py-4 mb-3">
        <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 76px; height: 76px;">
            <i class="fa-solid fa-check display-5"></i>
        </div>
        <h2 class="text-dark fw-extrabold mb-1">ĐẶT VÉ THÀNH CÔNG!</h2>
        <p class="text-muted fs-6 mb-2">Cảm ơn bạn đã lựa chọn CINESTAR CINEMA COMPLEX</p>
        <span class="badge bg-light text-dark border fs-6 px-3 py-2 shadow-sm">
            MÃ ĐƠN HÀNG: <strong class="text-danger"><%= booking.booking_code %></strong>
        </span>
    </div>

    <!-- Danh Sách Vé Điện Tử Với Mã QR (Light Theme) -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card bg-white border-0 p-4 rounded-4 shadow-sm mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h4 class="text-dark fw-bold mb-1"><%= booking.movie_title %></h4>
                        <div class="text-muted small">
                            <span class="badge bg-danger me-2"><%= booking.age_rating %></span>
                            <i class="fa-solid fa-door-open text-primary me-1"></i> <%= booking.room_name %> (<%= booking.screen_type %>) | 
                            <i class="fa-regular fa-clock text-info me-1"></i> <%= formatDateTime(booking.start_time) %>
                        </div>
                        <div class="mt-1 text-danger small fw-semibold">
                            <i class="fa-solid fa-location-dot me-1"></i> <strong><%= booking.cinema_name || 'Cinestar Cinema' %></strong> - <%= booking.cinema_address || '' %>
                        </div>
                        <div class="mt-2 text-secondary small">
                            <span class="badge bg-success-subtle text-success border border-success-subtle me-2">
                                <i class="fa-solid fa-circle-check me-1"></i> Đã thanh toán: <%= Number(booking.total_amount).toLocaleString('vi-VN') %> đ
                            </span>
                            <% if (booking.payment_method === 'mbbank_qr' || booking.payment_method === 'vnpay') { %>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    <i class="fa-solid fa-qrcode me-1"></i> MBBank VietQR (033320012005 - NGUYEN MANH QUYET)
                                </span>
                            <% } else { %>
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    Phương thức: <%= booking.payment_method %>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="mt-3 mt-md-0 d-print-none d-flex flex-wrap gap-2">
                        <% if (typeof currentUser !== 'undefined' && currentUser && (currentUser.role_name === 'staff' || currentUser.role_name === 'manager' || currentUser.role_name === 'admin')) { %>
                            <a href="/staff/pos" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold shadow-sm">
                                <i class="fa-solid fa-cash-register me-1"></i> Quay Lại Bán Vé POS
                            </a>
                        <% } %>
                        <button onclick="window.print()" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold shadow-sm">
                            <i class="fa-solid fa-print me-1"></i> In Vé / Lưu PDF
                        </button>
                    </div>
                </div>

                <!-- Lưới hiển thị từng Vé Điện Tử kèm QR Code -->
                <div class="row g-4 mb-4">
                    <% tickets.forEach(tkt => { %>
                        <div class="col-md-6">
                            <div class="card bg-light border p-3 rounded-4 h-100 d-flex flex-column justify-content-between shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-ticket text-danger fs-4"></i>
                                        <span class="fw-bold text-dark">VÉ ĐIỆN TỬ</span>
                                    </div>
                                    <span class="badge <%= tkt.status === 'unused' ? 'bg-success' : 'bg-secondary' %>">
                                        <%= tkt.status === 'unused' ? 'Chưa sử dụng' : 'Đã soát vé' %>
                                    </span>
                                </div>

                                <div class="row align-items-center g-3 my-2">
                                    <div class="col-5 text-center">
                                        <div class="bg-white p-2 rounded-3 border d-inline-block shadow-sm">
                                            <img src="<%= tkt.qr_data %>" alt="QR Code Ticket" class="img-fluid" style="width: 140px; height: 140px;">
                                        </div>
                                        <div class="small text-muted mt-1" style="font-size: 0.72rem;">Quét mã tại cửa rạp</div>
                                    </div>
                                    <div class="col-7">
                                        <div class="mb-2">
                                            <div class="text-muted small">Ghế ngồi:</div>
                                            <div class="fs-2 fw-extrabold text-danger"><%= tkt.seat_code %></div>
                                            <span class="badge bg-white text-dark border small fw-bold">
                                                <%= tkt.seat_type.toUpperCase() %>
                                            </span>
                                        </div>
                                        <div class="mb-1">
                                            <div class="text-muted small">Mã vé:</div>
                                            <code class="text-dark small fw-bold"><%= tkt.ticket_code %></code>
                                        </div>
                                        <div>
                                            <div class="text-muted small">Giá vé:</div>
                                            <div class="text-dark fw-bold"><%= Number(tkt.price).toLocaleString('vi-VN') %> đ</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="border-top pt-2 mt-2 text-center text-muted small" style="font-size: 0.75rem;">
                                    Xuất trình mã QR tại cửa phòng chiếu để nhân viên soát vé
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Combo bắp nước đi kèm nếu có -->
                <% if (combos && combos.length > 0) { %>
                    <div class="p-3 bg-light border rounded-3 mb-4">
                        <h6 class="text-dark fw-bold mb-2">
                            <i class="fa-solid fa-bowl-food text-warning me-2"></i> Combo Bắp Nước Kèm Theo:
                        </h6>
                        <div class="d-flex flex-wrap gap-2">
                            <% combos.forEach(c => { %>
                                <div class="badge bg-white text-dark border p-2 text-start">
                                    <%= c.combo_name %> <span class="text-danger fw-bold">x<%= c.quantity %></span>
                                    (<%= Number(c.total_price).toLocaleString('vi-VN') %> đ)
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <div class="d-flex justify-content-center flex-wrap gap-3 d-print-none mt-3">
                    <% if (typeof currentUser !== 'undefined' && currentUser && (currentUser.role_name === 'staff' || currentUser.role_name === 'manager' || currentUser.role_name === 'admin')) { %>
                        <a href="/staff/pos" class="btn btn-warning px-4 rounded-pill fw-bold shadow-sm">
                            <i class="fa-solid fa-cash-register me-1"></i> Quay Lại Bán Vé POS
                        </a>
                    <% } %>
                    <a href="/" class="btn btn-danger px-4 rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-house me-1"></i> Về Trang Chủ
                    </a>
                    <a href="/my-tickets" class="btn btn-outline-secondary px-4 rounded-pill fw-bold">
                        <i class="fa-solid fa-ticket me-1"></i> Xem Tất Cả Vé Của Tôi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
