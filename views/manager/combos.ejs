<%- include('../layouts/admin-header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-1">Quản Lý Combo Bắp Nước</h4>
        <p class="text-secondary small mb-0">Quản lý danh sách các món ăn nhẹ và đồ uống phục vụ tại rạp</p>
    </div>
    <button class="btn btn-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createComboModal">
        <i class="fa-solid fa-plus me-1"></i> Thêm Combo Mới
    </button>
</div>

<div class="row g-4">
    <% combos.forEach(c => { %>
        <div class="col-md-6 col-xl-3">
            <div class="card bg-card border-secondary rounded-4 overflow-hidden h-100 shadow d-flex flex-column">
                <div style="height: 150px; overflow: hidden;">
                    <img src="<%= c.image_url %>" alt="<%= c.name %>" class="w-100 h-100 object-fit-cover">
                </div>
                <div class="p-3 flex-grow-1 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h6 class="text-white fw-bold mb-0"><%= c.name %></h6>
                        <span class="badge <%= c.status === 'active' ? 'bg-success' : 'bg-secondary' %>">
                            <%= c.status === 'active' ? 'Đang bán' : 'Ngừng bán' %>
                        </span>
                    </div>
                    <p class="text-secondary small flex-grow-1 mb-2"><%= c.description %></p>
                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top border-secondary">
                        <span class="text-warning fw-bold fs-6"><%= Number(c.price).toLocaleString('vi-VN') %> đ</span>
                        <div class="d-flex gap-1">
                            <form action="/manager/combos/delete/<%= c.id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa combo này?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<!-- Modal Thêm Combo Mới -->
<div class="modal fade" id="createComboModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white fw-bold">Thêm Combo Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/manager/combos/create" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-light small fw-bold">Tên Combo <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control bg-dark border-secondary text-white" placeholder="VD: Combo Sweet Snack" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light small fw-bold">Mô tả chi tiết</label>
                        <textarea name="description" rows="2" class="form-control bg-dark border-secondary text-white" placeholder="1 Bắp lớn + 2 Nước ngọt..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light small fw-bold">Giá bán (VND) <span class="text-danger">*</span></label>
                        <input type="number" name="price" class="form-control bg-dark border-secondary text-white" step="1000" min="10000" placeholder="85000" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light small fw-bold">URL Ảnh minh họa</label>
                        <input type="url" name="image_url" class="form-control bg-dark border-secondary text-white" placeholder="https://images.unsplash.com/...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light small fw-bold">Trạng thái</label>
                        <select name="status" class="form-select bg-dark border-secondary text-white">
                            <option value="active">Đang kinh doanh</option>
                            <option value="inactive">Tạm ngưng</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Lưu Combo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layouts/admin-footer') %>
