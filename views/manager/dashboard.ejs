<%- include('../layouts/admin-header') %>

<!-- Thẻ Thống Kê Tổng Quan (Stat Cards) -->
<div class="row g-4 mb-4">
    <!-- 1. Tổng doanh thu -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div>
                <div class="text-secondary small fw-bold text-uppercase mb-1">Tổng Doanh Thu</div>
                <div class="fs-4 fw-extrabold text-white"><%= Number(stats.totalRevenue).toLocaleString('vi-VN') %> đ</div>
                <div class="small text-success mt-1"><i class="fa-solid fa-arrow-trend-up me-1"></i> Toàn hệ thống</div>
            </div>
            <div class="stat-icon icon-blue">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>
        </div>
    </div>

    <!-- 2. Doanh thu hôm nay -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div>
                <div class="text-secondary small fw-bold text-uppercase mb-1">Doanh Thu Hôm Nay</div>
                <div class="fs-4 fw-extrabold text-warning"><%= Number(stats.todayRevenue).toLocaleString('vi-VN') %> đ</div>
                <div class="small text-secondary mt-1"><i class="fa-solid fa-calendar-day me-1"></i> Hôm nay</div>
            </div>
            <div class="stat-icon icon-yellow">
                <i class="fa-solid fa-coins"></i>
            </div>
        </div>
    </div>

    <!-- 3. Tổng vé đã bán -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div>
                <div class="text-secondary small fw-bold text-uppercase mb-1">Tổng Vé Đã Bán</div>
                <div class="fs-4 fw-extrabold text-white"><%= stats.ticketsSold %> vé</div>
                <div class="small text-secondary mt-1"><%= stats.totalBookings %> đơn đặt hàng</div>
            </div>
            <div class="stat-icon icon-green">
                <i class="fa-solid fa-ticket"></i>
            </div>
        </div>
    </div>

    <!-- 4. TỶ LỆ LẤP ĐẦY RẠP (%) -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div>
                <div class="text-secondary small fw-bold text-uppercase mb-1">Tỷ Lệ Lấp Đầy Rạp</div>
                <div class="fs-4 fw-extrabold text-info"><%= stats.occupancyRate %>%</div>
                <div class="small text-secondary mt-1">Occupancy Rate</div>
            </div>
            <div class="stat-icon icon-purple">
                <i class="fa-solid fa-chart-pie"></i>
            </div>
        </div>
    </div>
</div>

<!-- Biểu Đồ Thống Kê (Chart.js) -->
<div class="row g-4 mb-4">
    <!-- Biểu đồ doanh thu 7 ngày -->
    <div class="col-lg-8">
        <div class="card bg-card border-secondary p-4 rounded-4 shadow h-100">
            <h5 class="text-white fw-bold mb-3 d-flex align-items-center justify-content-between">
                <span><i class="fa-solid fa-chart-column text-danger me-2"></i> Doanh Thu 7 Ngày Gần Nhất</span>
                <span class="badge bg-dark border border-secondary text-secondary small">VND</span>
            </h5>
            <div style="height: 280px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Biểu đồ phân bổ loại ghế bán ra -->
    <div class="col-lg-4">
        <div class="card bg-card border-secondary p-4 rounded-4 shadow h-100">
            <h5 class="text-white fw-bold mb-3">
                <i class="fa-solid fa-chart-pie text-warning me-2"></i> Cơ Cấu Vé Theo Loại Ghế
            </h5>
            <div style="height: 240px; position: relative;">
                <canvas id="seatTypeChart"></canvas>
            </div>
            <div class="text-center text-secondary small mt-2">
                Phân bổ vé Thường, VIP và Sweetbox
            </div>
        </div>
    </div>
</div>

<!-- Bảng Top Phim & Suất Chiếu Hôm Nay -->
<div class="row g-4 mb-4">
    <!-- Top Phim Ăn Khách -->
    <div class="col-lg-6">
        <div class="card bg-card border-secondary p-4 rounded-4 shadow h-100">
            <h5 class="text-white fw-bold mb-3 border-bottom border-secondary pb-2">
                <i class="fa-solid fa-trophy text-warning me-2"></i> Top Phim Doanh Thu Cao Nhất
            </h5>
            <div class="table-responsive">
                <table class="table table-dark table-borderless align-middle mb-0">
                    <thead>
                        <tr class="border-bottom border-secondary text-secondary small">
                            <th>TÊN PHIM</th>
                            <th>VÉ ĐÃ BÁN</th>
                            <th class="text-end">DOANH THU</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (stats.topMovies && stats.topMovies.length > 0) { %>
                            <% stats.topMovies.forEach((m, idx) => { %>
                                <tr>
                                    <td>
                                        <span class="badge <%= idx === 0 ? 'bg-warning text-dark' : (idx === 1 ? 'bg-secondary' : 'bg-dark border border-secondary') %> me-1">
                                            #<%= idx + 1 %>
                                        </span>
                                        <strong class="text-white"><%= m.title %></strong>
                                    </td>
                                    <td><span class="badge bg-danger"><%= m.tickets_sold %> vé</span></td>
                                    <td class="text-end text-warning fw-bold"><%= Number(m.movie_revenue).toLocaleString('vi-VN') %> đ</td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="3" class="text-center text-secondary py-3">Chưa có dữ liệu</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Suất Chiếu Hôm Nay -->
    <div class="col-lg-6">
        <div class="card bg-card border-secondary p-4 rounded-4 shadow h-100">
            <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-3">
                <h5 class="text-white fw-bold mb-0">
                    <i class="fa-solid fa-calendar-check text-info me-2"></i> Lịch Chiếu Hôm Nay
                </h5>
                <a href="/manager/showtimes/create" class="btn btn-outline-danger btn-sm rounded-pill">
                    <i class="fa-solid fa-plus me-1"></i> Xếp Lịch Mới
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-borderless align-middle mb-0">
                    <thead>
                        <tr class="border-bottom border-secondary text-secondary small">
                            <th>GIỜ CHIẾU</th>
                            <th>PHIM</th>
                            <th>PHÒNG</th>
                            <th>TỶ LỆ LẤP ĐẦY</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (todayShowtimes && todayShowtimes.length > 0) { %>
                            <% todayShowtimes.forEach(st => { %>
                                <tr>
                                    <td><span class="badge bg-danger"><%= formatTime(st.start_time) %></span></td>
                                    <td class="fw-bold text-white text-truncate" style="max-width: 150px;" title="<%= st.movie_title %>">
                                        <%= st.movie_title %>
                                    </td>
                                    <td class="small text-secondary"><%= st.room_name %></td>
                                    <td>
                                        <% const occ = Math.round((st.sold_seats / (st.total_seats || 1)) * 100); %>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                <div class="progress-bar bg-success" style="width: <%= occ %>%"></div>
                                            </div>
                                            <span class="small text-secondary" style="font-size: 0.75rem;"><%= st.sold_seats %>/<%= st.total_seats %> (<%= occ %>%)</span>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4" class="text-center text-secondary py-3">Chưa có suất chiếu hôm nay</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Chart Scripts -->
<script>
// 1. Biểu đồ Doanh thu 7 ngày
const revenueData = <%- JSON.stringify(stats.revenueByDays || []) %>;
const dates = revenueData.map(d => (d.date_str && typeof d.date_str === 'string' ? d.date_str.split('-').slice(1).join('/') : String(d.date_str || '')));
const revenues = revenueData.map(d => d.revenue);

const ctxRev = document.getElementById('revenueChart').getContext('2d');
new Chart(ctxRev, {
    type: 'bar',
    data: {
        labels: dates,
        datasets: [{
            label: 'Doanh thu (VND)',
            data: revenues,
            backgroundColor: 'rgba(229, 9, 20, 0.75)',
            borderColor: '#e50914',
            borderWidth: 1,
            borderRadius: 6
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false }
        },
        scales: {
            y: {
                beginAtZero: true,
                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                ticks: { color: '#9ca3af' }
            },
            x: {
                grid: { display: false },
                ticks: { color: '#9ca3af' }
            }
        }
    }
});

// 2. Biểu đồ loại ghế
const seatTypeData = <%- JSON.stringify(stats.seatTypeStats || []) %>;
const seatLabels = seatTypeData.map(s => s.seat_type.toUpperCase());
const seatCounts = seatTypeData.map(s => s.count);

const ctxSeat = document.getElementById('seatTypeChart').getContext('2d');
new Chart(ctxSeat, {
    type: 'doughnut',
    data: {
        labels: seatLabels.length ? seatLabels : ['Chưa có dữ liệu'],
        datasets: [{
            data: seatCounts.length ? seatCounts : [1],
            backgroundColor: ['#4b5563', '#f59e0b', '#ec4899'],
            borderWidth: 2,
            borderColor: '#1e2538'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'bottom',
                labels: { color: '#9ca3af', boxWidth: 12 }
            }
        }
    }
});
</script>

<%- include('../layouts/admin-footer') %>
