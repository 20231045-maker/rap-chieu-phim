<%- include('../layouts/admin-header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-1">Báo Cáo Doanh Thu & Hiệu Quả Khai Thác</h4>
        <p class="text-secondary small mb-0">Thống kê chi tiết doanh thu, số vé bán, tỷ lệ lấp đầy rạp và lịch sử giao dịch</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-light rounded-pill px-3 btn-sm">
        <i class="fa-solid fa-print me-1"></i> Xuất Báo Cáo / In PDF
    </button>
</div>

<!-- Tổng Hợp Chỉ Số Kinh Doanh -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card bg-card border-secondary p-3 rounded-4 shadow">
            <div class="text-secondary small">TỔNG DOANH THU</div>
            <div class="fs-4 fw-extrabold text-danger"><%= Number(stats.totalRevenue).toLocaleString('vi-VN') %> đ</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-card border-secondary p-3 rounded-4 shadow">
            <div class="text-secondary small">DOANH THU HÔM NAY</div>
            <div class="fs-4 fw-extrabold text-warning"><%= Number(stats.todayRevenue).toLocaleString('vi-VN') %> đ</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-card border-secondary p-3 rounded-4 shadow">
            <div class="text-secondary small">TỔNG SỐ VÉ ĐÃ XUẤT</div>
            <div class="fs-4 fw-extrabold text-white"><%= stats.ticketsSold %> vé</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-card border-secondary p-3 rounded-4 shadow">
            <div class="text-secondary small">TỶ LỆ LẤP ĐẦY RẠP (OCCUPANCY)</div>
            <div class="fs-4 fw-extrabold text-info"><%= stats.occupancyRate %>%</div>
        </div>
    </div>
</div>

<!-- Bảng Lịch Sử Giao Dịch Chi Tiết -->
<div class="card bg-card border-secondary rounded-4 shadow overflow-hidden">
    <div class="p-3 border-bottom border-secondary">
        <h5 class="text-white fw-bold mb-0">
            <i class="fa-solid fa-list-check text-warning me-2"></i> Chi Tiết Toàn Bộ Giao Dịch Đặt Vé
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-borderless align-middle mb-0">
            <thead>
                <tr class="border-bottom border-secondary text-secondary small">
                    <th>MÃ ĐƠN</th>
                    <th>KHÁCH HÀNG</th>
                    <th>PHIM</th>
                    <th>PHÒNG</th>
                    <th>SUẤT CHIẾU</th>
                    <th>SỐ VÉ</th>
                    <th>HÌNH THỨC</th>
                    <th>TỔNG TIỀN</th>
                    <th>THỜI GIAN</th>
                </tr>
            </thead>
            <tbody>
                <% if (bookings && bookings.length > 0) { %>
                    <% bookings.forEach(b => { %>
                        <tr class="border-bottom border-secondary border-opacity-25 small">
                            <td><code><%= b.booking_code %></code></td>
                            <td>
                                <div class="fw-bold text-white"><%= b.customer_name %></div>
                                <div class="text-secondary" style="font-size: 0.72rem;"><%= b.customer_phone || b.customer_email %></div>
                            </td>
                            <td class="text-white"><%= b.movie_title %></td>
                            <td><%= b.room_name %></td>
                            <td><span class="badge bg-danger"><%= formatDateTime(b.start_time) %></span></td>
                            <td><span class="badge bg-secondary"><%= b.ticket_count %> vé</span></td>
                            <td>
                                <span class="badge <%= b.booking_type === 'pos' ? 'bg-warning text-dark' : 'bg-primary' %>">
                                    <%= b.booking_type.toUpperCase() %> (<%= b.payment_method %>)
                                </span>
                            </td>
                            <td class="text-warning fw-bold"><%= Number(b.total_amount).toLocaleString('vi-VN') %> đ</td>
                            <td class="text-secondary"><%= formatDateTime(b.created_at) %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="9" class="text-center text-secondary py-4">Chưa có dữ liệu giao dịch</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layouts/admin-footer') %>
